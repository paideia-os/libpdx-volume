// src/pdxb_checksum.pdx — libpdx-volume.M1-002 (issue #17)
// PdxbChecksum: CRC32C (Castagnoli, polynomial 0x1EDC6F41) over the
// signed range [0, 696) of a PDXB v1 superblock, for cheap bit-rot
// detection ahead of the (expensive) full ML-DSA-65 signature verify.
//
// This module lives alongside `src/pdxb_superblock.pdx` (M2-001/M2-002)
// rather than being folded into it, because a 256-entry .rodata lookup
// table plus a slice-by-1 CRC loop is a self-contained concern with its
// own module-level constant and its own leaf loop -- the codec module
// already carries enough justification comments per function that
// grafting a third public entry point on with its own scratch table
// would blur the "one file, one wire-format concern" split the M1
// design in design/architecture.md §6 established.
//
// The CRC is NOT part of the on-disk PDXB v1 wire format -- design/
// architecture.md §3.1 explicitly notes there is no on-disk checksum
// field and the parser's fourth gate substitutes `block_size == 4096`
// in its place. This module is an IN-MEMORY-only helper: mkfs.pdxfs
// (post-write self-check) and mount.pdxfs (pre-signature-verify
// integrity screen) compute a CRC over a superblock buffer they already
// hold and either compare against a caller-supplied expected value
// (`pdxb_verify_checksum`) or use the raw hash (`pdxb_superblock_
// checksum`) for some other purpose. A future PDXB v2 that persists the
// CRC into an on-disk slot is a separate wire-format ticket.
//
// -----------------------------------------------------------------------------
// The lookup table -- 256 entries, 2048 bytes of .rodata
// -----------------------------------------------------------------------------
//
// Standard byte-at-a-time CRC32C table, generated from the reflected
// Castagnoli polynomial 0x82F63B78 (the bit-reverse of 0x1EDC6F41):
//
//   for i in 0..256 {
//     let mut c = i as u32;
//     for _ in 0..8 {
//       c = if c & 1 != 0 { (c >> 1) ^ 0x82F63B78 } else { c >> 1 };
//     }
//     table[i] = c;
//   }
//
// The 256 u32 values below were generated offline via that formula and
// match the reference IETF test vectors (see RFC 3720 iSCSI Appendix B
// / RFC 7143). No paideia-as CRC32C intrinsic exists in the stdlib as
// of v0.28.0 (grep across `tools/paideia-as/crates/paideia-stdlib/pdx/`
// hits only `checksum.pdx`, which is RFC 1071 IP-checksum, not CRC32C).
//
// Storage: `.rodata` u32 array (write-once at link time; the constant-
// initialised array literal syntax `[u32; 256] = [ ... ]` is already
// proven in this repo's test drivers for smaller arrays, and paideia-as
// accepts u32 immediates directly since none exceeds 0xFFFFFFFF).
//
// -----------------------------------------------------------------------------
// paideia-as encoder notes
// -----------------------------------------------------------------------------
//
//   - `mov_b r10, [rdi + rcx]` for the per-byte load: `mov_b` zero-
//     extends into the full 64-bit register per this codebase's G1
//     sized-load discipline (proven in kind_blkdev.pdx / mmio.pdx),
//     matching the byte-oriented CRC loop shape.
//   - `mov_d r11, [rsi + r9 * 4]` for the per-byte table lookup:
//     `mov_d` zero-extends a 32-bit load, and the SIB `r9 * 4` scale
//     is proven at src/mount_table_snapshot.pdx (which uses `r13 * 8`
//     for its own array indexing).
//   - `xor` reg,reg and reg,imm both encode cleanly; `xor r8, r10` for
//     mixing byte with running CRC, `xor r8, r11` for mixing table
//     lookup back in.
//   - `shr r8, 8` for the CRC advance: shift-count immediate is small
//     unsigned (8 well below 63), no encoder trap.
//   - `and r10, 0xFF` for the byte-mask after XOR mix: 0xFF is a small
//     imm8, no r11 staging needed.
//   - `and rax, r11` used nowhere here -- the CRC32C's final step is a
//     bit-inversion (XOR with all-ones), and this repo's established
//     workaround for the AND-with-all-ones encoder trap
//     (see test_pdxb_roundtrip.pdx module header) is to XOR with an
//     all-ones register loaded via MOVABS, which does not have the
//     same imm-encoding constraint.
//   - No `add reg, [mem]` anywhere. No `test`; every check is `cmp`.
//   - Labels prefixed `pdxb_ck_` (checksum) and `pdxb_vk_` (verify_
//     checksum, distinct from vol_kind's `lpv_vk_` and always tagged as
//     the checksum verifier at each use).
//
// Upstream: design/tooling/volume-tooling-ux.md §9.4 (libpdx-volume#17);
// design/architecture.md §3.1 (this repo, why no on-disk checksum);
// RFC 3720 Appendix B (CRC32C reference vectors).

module PdxbChecksum = structure {

  // Signed range length: same 696 bytes pdxb_sign_superblock covers
  // (design/filesystem/volume-fs-substrate.md §2.1, paideia-os).
  // Duplicated per this repo's no-cross-module-constant-import
  // convention (pdxb_sign.pdx does the same for its own copy).
  pub let PDXB_CHECKSUM_MSG_LEN : u64 = 696

  // Status codes -- 0 = OK convention every other module in this repo
  // uses. Reserved in the LPV_PDXB_* band (see src/lpv_errors.pdx
  // M1-004 for the full band map).
  pub let PDXB_OK               : u64 = 0
  pub let PDXB_ERR_CRC_MISMATCH : u64 = 5

  // ==========================================================================
  // pdxb_crc32c_table -- 256 u32 entries, Castagnoli reflected form.
  // Generated via the RFC 3720 Appendix B algorithm; every entry
  // verified against the reference implementation in
  // https://tools.ietf.org/rfc/rfc3720.txt (iSCSI CRC-32C test vectors).
  // ==========================================================================
  pub let pdxb_crc32c_table : [u32; 256] = [
    0x00000000, 0xF26B8303, 0xE13B70F7, 0x1350F3F4,
    0xC79A971F, 0x35F1141C, 0x26A1E7E8, 0xD4CA64EB,
    0x8AD958CF, 0x78B2DBCC, 0x6BE22838, 0x9989AB3B,
    0x4D43CFD0, 0xBF284CD3, 0xAC78BF27, 0x5E133C24,
    0x105EC76F, 0xE235446C, 0xF165B798, 0x030E349B,
    0xD7C45070, 0x25AFD373, 0x36FF2087, 0xC494A384,
    0x9A879FA0, 0x68EC1CA3, 0x7BBCEF57, 0x89D76C54,
    0x5D1D08BF, 0xAF768BBC, 0xBC267848, 0x4E4DFB4B,
    0x20BD8EDE, 0xD2D60DDD, 0xC186FE29, 0x33ED7D2A,
    0xE72719C1, 0x154C9AC2, 0x061C6936, 0xF477EA35,
    0xAA64D611, 0x580F5512, 0x4B5FA6E6, 0xB93425E5,
    0x6DFE410E, 0x9F95C20D, 0x8CC531F9, 0x7EAEB2FA,
    0x30E349B1, 0xC288CAB2, 0xD1D83946, 0x23B3BA45,
    0xF779DEAE, 0x05125DAD, 0x1642AE59, 0xE4292D5A,
    0xBA3A117E, 0x4851927D, 0x5B016189, 0xA96AE28A,
    0x7DA08661, 0x8FCB0562, 0x9C9BF696, 0x6EF07595,
    0x417B1DBC, 0xB3109EBF, 0xA0406D4B, 0x522BEE48,
    0x86E18AA3, 0x748A09A0, 0x67DAFA54, 0x95B17957,
    0xCBA24573, 0x39C9C670, 0x2A993584, 0xD8F2B687,
    0x0C38D26C, 0xFE53516F, 0xED03A29B, 0x1F682198,
    0x5125DAD3, 0xA34E59D0, 0xB01EAA24, 0x42752927,
    0x96BF4DCC, 0x64D4CECF, 0x77843D3B, 0x85EFBE38,
    0xDBFC821C, 0x2997011F, 0x3AC7F2EB, 0xC8AC71E8,
    0x1C661503, 0xEE0D9600, 0xFD5D65F4, 0x0F36E6F7,
    0x61C69362, 0x93AD1061, 0x80FDE395, 0x72966096,
    0xA65C047D, 0x5437877E, 0x4767748A, 0xB50CF789,
    0xEB1FCBAD, 0x197448AE, 0x0A24BB5A, 0xF84F3859,
    0x2C855CB2, 0xDEEEDFB1, 0xCDBE2C45, 0x3FD5AF46,
    0x7198540D, 0x83F3D70E, 0x90A324FA, 0x62C8A7F9,
    0xB602C312, 0x44694011, 0x5739B3E5, 0xA55230E6,
    0xFB410CC2, 0x092A8FC1, 0x1A7A7C35, 0xE811FF36,
    0x3CDB9BDD, 0xCEB018DE, 0xDDE0EB2A, 0x2F8B6829,
    0x82F63B78, 0x709DB87B, 0x63CD4B8F, 0x91A6C88C,
    0x456CAC67, 0xB7072F64, 0xA457DC90, 0x563C5F93,
    0x082F63B7, 0xFA44E0B4, 0xE9141340, 0x1B7F9043,
    0xCFB5F4A8, 0x3DDE77AB, 0x2E8E845F, 0xDCE5075C,
    0x92A8FC17, 0x60C37F14, 0x73938CE0, 0x81F80FE3,
    0x55326B08, 0xA759E80B, 0xB4091BFF, 0x466298FC,
    0x1871A4D8, 0xEA1A27DB, 0xF94AD42F, 0x0B21572C,
    0xDFEB33C7, 0x2D80B0C4, 0x3ED04330, 0xCCBBC033,
    0xA24BB5A6, 0x502036A5, 0x4370C551, 0xB11B4652,
    0x65D122B9, 0x97BAA1BA, 0x84EA524E, 0x7681D14D,
    0x2892ED69, 0xDAF96E6A, 0xC9A99D9E, 0x3BC21E9D,
    0xEF087A76, 0x1D63F975, 0x0E330A81, 0xFC588982,
    0xB21572C9, 0x407EF1CA, 0x532E023E, 0xA145813D,
    0x758FE5D6, 0x87E466D5, 0x94B49521, 0x66DF1622,
    0x38CC2A06, 0xCAA7A905, 0xD9F75AF1, 0x2B9CD9F2,
    0xFF56BD19, 0x0D3D3E1A, 0x1E6DCDEE, 0xEC064EED,
    0xC38D26C4, 0x31E6A5C7, 0x22B65633, 0xD0DDD530,
    0x0417B1DB, 0xF67C32D8, 0xE52CC12C, 0x1747422F,
    0x49547E0B, 0xBB3FFD08, 0xA86F0EFC, 0x5A048DFF,
    0x8ECEE914, 0x7CA56A17, 0x6FF599E3, 0x9D9E1AE0,
    0xD3D3E1AB, 0x21B862A8, 0x32E8915C, 0xC083125F,
    0x144976B4, 0xE622F5B7, 0xF5720643, 0x07198540,
    0x590AB964, 0xAB613A67, 0xB831C993, 0x4A5A4A90,
    0x9E902E7B, 0x6CFBAD78, 0x7FAB5E8C, 0x8DC0DD8F,
    0xE330A81A, 0x115B2B19, 0x020BD8ED, 0xF0605BEE,
    0x24AA3F05, 0xD6C1BC06, 0xC5914FF2, 0x37FACCF1,
    0x69E9F0D5, 0x9B8273D6, 0x88D28022, 0x7AB90321,
    0xAE7367CA, 0x5C18E4C9, 0x4F48173D, 0xBD23943E,
    0xF36E6F75, 0x0105EC76, 0x12551F82, 0xE03E9C81,
    0x34F4F86A, 0xC69F7B69, 0xD5CF889D, 0x27A40B9E,
    0x79B737BA, 0x8BDCB4B9, 0x988C474D, 0x6AE7C44E,
    0xBE2DA0A5, 0x4C4623A6, 0x5F16D052, 0xAD7D5351
  ] @align(8)

  // ==========================================================================
  // pdxb_superblock_checksum(sb_ptr: u64, buf_len: u64) -> u64
  //   rdi = sb_ptr    (buffer >= PDXB_CHECKSUM_MSG_LEN = 696 bytes)
  //   rsi = buf_len    (caller-declared readable length; must be >= 696)
  //   rax = CRC32C u32 zero-extended into u64, or PDXB_ERR_CRC_MISMATCH
  //          (used here as a distinct sentinel meaning "buf_len too short"
  //          -- 5 is well outside the valid CRC32C range's upper half so
  //          collision with a real hash is impossible in practice; the
  //          real "checksum mismatch" pair happens in
  //          pdxb_verify_checksum below).
  //
  // Slice-by-1 (byte-at-a-time) CRC32C:
  //   crc = 0xFFFFFFFF
  //   for i in 0..696:
  //     idx = (crc ^ byte[i]) & 0xFF
  //     crc = (crc >> 8) ^ table[idx]
  //   return crc ^ 0xFFFFFFFF
  //
  // Leaf function: no nested calls, no callee-save touched
  // (rax/rcx/r8/r9/r10/r11 only). No push/pop.
  // ==========================================================================
  pub let pdxb_superblock_checksum : (u64, u64) -> u64 !{mem} @{} =
    fn (sb_ptr: u64) (buf_len: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-volume.M1-002 (#17): pdxb_superblock_checksum real body. Gate: cmp rsi,696; jb too_short -- returns PDXB_ERR_CRC_MISMATCH (5) as the distinct too-short sentinel. Body: initialise CRC r8 = 0xFFFFFFFF via mov r8,rax where rax was seeded by MOVABS-loading 0xFFFFFFFFFFFFFFFF then shr rax,32 (no direct 0xFFFFFFFF imm since paideia-as's AND/OR imm-encoding rejects it per the imm8/imm32 sign-extension trap guard test_pdxb_roundtrip.pdx documents; the double-shift workaround is proven at that file). Also load rsi (table base) via lea r9_scratch, then move to a fixed table register. Loop i=0..696 (rcx=i, xor-zeroed): cmp rcx,696; jae done. Load per-byte: mov_b r10,[rdi+rcx] (byte i, zero-extended into r10). Compute table index: mov r11,r8; xor r11,r10; and r11,0xFF (small imm8, no staging). Table lookup: mov_d r11,[rsi_table+r11*4] (SIB scale 4, u32 load zero-extended). Advance: shr r8,8; xor r8,r11. add rcx,1; jmp loop. done: xor r8 with all-ones-in-low-32 via mov r11,0xFFFFFFFF-equivalent (stage via MOVABS-then-shr like the seed) and xor r8,r11; return the resulting u32 zero-extended in rax. No add reg,[mem]. Byte load uses mov_b + zero-extend (implicit for mov_b), matching kind_blkdev.pdx precedent. No test; every check is cmp. Labels prefixed pdxb_ck_.",
      block: {
        // Gate: buffer must cover the full signed range.
        cmp rsi, 696;
        jb  pdxb_ck_too_short;

        // Seed CRC = 0xFFFFFFFF via MOVABS-then-shr (see justification).
        mov rax, 0xFFFFFFFFFFFFFFFF;
        shr rax, 32;
        mov r8, rax;                     // r8 = running CRC

        // Stage table base into rsi (repurposing rsi -- buf_len is no
        // longer needed past the gate; a fresh lea keeps this a leaf).
        lea rsi, [rip + pdxb_crc32c_table];

        xor rcx, rcx;                    // i = 0

      pdxb_ck_loop:
        cmp rcx, 696;
        jae pdxb_ck_done;

        // idx = (crc ^ byte[i]) & 0xFF
        mov_b r10, [rdi + rcx * 1];      // byte i, zero-extended (explicit scale)
        mov r11, r8;
        xor r11, r10;
        and r11, 0xFF;

        // crc = (crc >> 8) ^ table[idx]
        mov_d r11, [rsi + r11 * 4];      // u32 load, zero-extended
        shr r8, 8;
        xor r8, r11;

        add rcx, 1;
        jmp pdxb_ck_loop;

      pdxb_ck_done:
        // Final XOR with 0xFFFFFFFF (bit-invert low 32 bits).
        mov rax, 0xFFFFFFFFFFFFFFFF;
        shr rax, 32;
        xor r8, rax;

        mov rax, r8;                     // return CRC32C in rax
        ret;

      pdxb_ck_too_short:
        mov rax, 5;                      // PDXB_ERR_CRC_MISMATCH sentinel
        ret;
      }
    }

  // ==========================================================================
  // pdxb_verify_checksum(sb_ptr: u64, expected_crc32c: u64) -> u64
  //   rdi = sb_ptr           (buffer >= 696 bytes)
  //   rsi = expected_crc32c   (u32 zero-extended; the caller's saved CRC)
  //   rax = PDXB_OK (0) if computed CRC matches expected,
  //         PDXB_ERR_CRC_MISMATCH (5) otherwise.
  //
  // Wraps pdxb_superblock_checksum with an equality gate. rsi is saved
  // across the call via r12 (the ONE callee-save register whose
  // preservation cost -- one push, one pop -- is cheaper than reloading
  // from a memory slot in this leaf-plus-one-call function). r12 is not
  // touched by the internal pdxb_superblock_checksum body per its
  // documented register plan.
  // ==========================================================================
  pub let pdxb_verify_checksum : (u64, u64) -> u64 !{mem} @{} =
    fn (sb_ptr: u64) (expected_crc32c: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-volume.M1-002 (#17): pdxb_verify_checksum wraps pdxb_superblock_checksum with an equality gate. Save expected_crc32c across the internal call via push r12; mov r12,rsi. Marshal SysV args: mov rsi,696 (buf_len -- the caller doesn't have to pass one to this two-arg helper); call pdxb_superblock_checksum. On return rax holds the computed CRC (or the too-short sentinel, which will simply fail the equality gate below without a distinct code path). Compare via cmp rax,r12; jne mismatch. Match: xor rax,rax (PDXB_OK); pop r12; ret. Mismatch: mov rax,5 (PDXB_ERR_CRC_MISMATCH); pop r12; ret. No add reg,[mem]. No byte loads at this level (the callee handles those). No test; only cmp. Labels prefixed pdxb_vk_ (verify-checksum, distinct from vol_kind's lpv_vk_).",
      block: {
        push r12;
        mov r12, rsi;                    // preserve expected CRC

        // Marshal for pdxb_superblock_checksum(sb_ptr, buf_len).
        mov rsi, 696;                    // buf_len = PDXB_CHECKSUM_MSG_LEN
        call pdxb_superblock_checksum;

        // Equality gate.
        cmp rax, r12;
        jne pdxb_vk_mismatch;

        xor rax, rax;                    // PDXB_OK
        pop r12;
        ret;

      pdxb_vk_mismatch:
        mov rax, 5;                      // PDXB_ERR_CRC_MISMATCH
        pop r12;
        ret;
      }
    }
}
