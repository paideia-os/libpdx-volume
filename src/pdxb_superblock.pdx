  // --- sig_key_hash: four consecutive u64 slots at +144, +152, +160, +168.
  // Accessor takes word_idx in [0..3]; caller-checked. Out-of-range
  // reads whatever is at sb_ptr + 144 + word_idx*8 without a gate,
  // matching this library's "trust the caller" discipline elsewhere. ---
  pub let pdxb_sb_get_sig_key_hash_word : (u64, u64) -> u64 !{mem} @{} =
    fn (sb_ptr: u64) (word_idx: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-volume.M1-003 (#18): sig_key_hash word accessor. Base = sb_ptr + 144 (SBS_OFF_SIG_KEY_HASH); index = word_idx*8. mov rcx,rsi; shl rcx,3 (index bytes); mov rax,rdi; add rax,rcx (base + index, register-register, never lea reg,[regA+regB]); mov rax,[rax+144]; ret. No `add reg,[mem]`; register-only arithmetic. No shift-count issue (3 is a small unsigned immediate).",
      block: {
        mov rcx, rsi;
        shl rcx, 3;
        mov rax, rdi;
        add rax, rcx;
        mov rax, [rax + 144];
        ret;
      }
    }

  // --- Setters for every writable field mkfs.pdxfs needs. Same shape:
  //     rdi = sb_ptr, rsi = value; return void (rax not written).
  //     Constants like PDXB_MAGIC / PDXB_VERSION_V1 / PDXB_BLOCK_SIZE
  //     also get setters even though a real mkfs writes them once at
  //     format time, so the setter set is complete for a fuzzer that
  //     wants to mutate every slot. ---

  pub let pdxb_sb_set_magic : (u64, u64) -> u64 !{mem} @{} =
    fn (sb_ptr: u64) (value: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-volume.M1-003 (#18): setter for SBS_OFF_MAGIC (+0). mov [rdi+0],rsi; xor rax,rax; ret.",
      block: { mov [rdi + 0], rsi; xor rax, rax; ret; }
    }

  pub let pdxb_sb_set_version : (u64, u64) -> u64 !{mem} @{} =
    fn (sb_ptr: u64) (value: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-volume.M1-003 (#18): setter for SBS_OFF_VERSION (+8).",
      block: { mov [rdi + 8], rsi; xor rax, rax; ret; }
    }

