  // ==========================================================================
  // libpdx-volume.M5-002 (#30) -- PDXB v2 wrapped-DEK / KDF-salt / nonce
  // accessors.
  //
  // Slot layout in the superblock's on-disk _reserved region (v2 only):
  //
  //   [+192, +240)  wrapped_dek   32 B ciphertext || 16 B tag = 48 B
  //   [+240, +256)  kdf_salt      16 B
  //   [+256, +268)  wrap_nonce    12 B
  //
  // The signed range is [0, 696), so all three slots fall inside it --
  // tampering with them fails pdxb_verify_superblock's signature check.
  //
  // These accessors operate on the RAW on-disk 4096-byte superblock
  // buffer (the same shape pdxb_parse/encode_superblock take), NOT on
  // the 176-byte PdxbSuperblockSummary -- the summary intentionally
  // does not decode _reserved and would not have slots for these fields
  // anyway. `pdxb_sb_is_encrypted` reads the summary's flags slot
  // (SBS_OFF_FLAGS +40); the wrapped-DEK/salt/nonce accessors read the
  // on-disk buffer's _reserved offsets (192/240/256).
  //
  // Layout choice rationale (from the issue brief's own trade-off
  // request): this landing picks the **paired-block scheme** for per-
  // block AEAD metadata (data_lba is ciphertext; a per-16-block
  // metadata block at data_lba + N*16 holds 16x(12B nonce + 16B tag) =
  // 448 bytes) over the inline-trailer scheme (4124-byte on-disk unit)
  // because paideia-os block devices are frozen at 4KiB units and the
  // inline trailer would require every block device to expose a
  // 4KiB+28B addressable unit (which none does today). The 2x metadata
  // read overhead is bounded and cacheable; the addressability change
  // would cascade across every existing block driver. This trade-off
  // is documented in this file and in design/architecture.md §11.
  // ==========================================================================

  pub let PDXB_D_OFF_WRAPPED_DEK : u64 = 192   // 48 B (32 ct + 16 tag)
  pub let PDXB_D_OFF_KDF_SALT    : u64 = 240   // 16 B
  pub let PDXB_D_OFF_WRAP_NONCE  : u64 = 256   // 12 B
  pub let PDXB_WRAPPED_DEK_BYTES : u64 = 48
  pub let PDXB_KDF_SALT_BYTES    : u64 = 16
  pub let PDXB_WRAP_NONCE_BYTES  : u64 = 12

  // pdxb_sb_get_wrapped_dek(sb_ptr, out_ptr): copies 48 bytes from
  // sb_ptr + 192 to out_ptr. Six qword copies (48 / 8 = 6, exact).
  pub let pdxb_sb_get_wrapped_dek : (u64, u64) -> u64 !{mem} @{} =
    fn (sb_ptr: u64) (out_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-volume.M5-002 (#30): copy wrapped_dek [192, 240) (48 B = 6 qwords). Six load/store pairs at fixed offsets, matching pdxb_parse_superblock's per-slot idiom. No add reg,[mem]; no loop needed at this size.",
      block: {
        mov rax, [rdi + 192];  mov [rsi + 0], rax;
        mov rax, [rdi + 200];  mov [rsi + 8], rax;
        mov rax, [rdi + 208];  mov [rsi + 16], rax;
        mov rax, [rdi + 216];  mov [rsi + 24], rax;
        mov rax, [rdi + 224];  mov [rsi + 32], rax;
        mov rax, [rdi + 232];  mov [rsi + 40], rax;
        xor rax, rax; ret;
      }
    }

  pub let pdxb_sb_set_wrapped_dek : (u64, u64) -> u64 !{mem} @{} =
    fn (sb_ptr: u64) (wrapped_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-volume.M5-002 (#30): inverse of pdxb_sb_get_wrapped_dek. Six load/store pairs.",
      block: {
        mov rax, [rsi + 0];   mov [rdi + 192], rax;
        mov rax, [rsi + 8];   mov [rdi + 200], rax;
        mov rax, [rsi + 16];  mov [rdi + 208], rax;
        mov rax, [rsi + 24];  mov [rdi + 216], rax;
        mov rax, [rsi + 32];  mov [rdi + 224], rax;
        mov rax, [rsi + 40];  mov [rdi + 232], rax;
        xor rax, rax; ret;
      }
    }

  // pdxb_sb_get_kdf_salt(sb_ptr, out_ptr): copies 16 bytes from
  // sb_ptr + 240 to out_ptr.
  pub let pdxb_sb_get_kdf_salt : (u64, u64) -> u64 !{mem} @{} =
    fn (sb_ptr: u64) (out_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-volume.M5-002 (#30): copy kdf_salt [240, 256) (16 B = 2 qwords).",
      block: {
        mov rax, [rdi + 240];  mov [rsi + 0], rax;
        mov rax, [rdi + 248];  mov [rsi + 8], rax;
        xor rax, rax; ret;
      }
    }

  pub let pdxb_sb_set_kdf_salt : (u64, u64) -> u64 !{mem} @{} =
    fn (sb_ptr: u64) (salt_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-volume.M5-002 (#30): inverse of pdxb_sb_get_kdf_salt.",
      block: {
        mov rax, [rsi + 0];  mov [rdi + 240], rax;
        mov rax, [rsi + 8];  mov [rdi + 248], rax;
        xor rax, rax; ret;
      }
    }

  // pdxb_sb_is_encrypted(sb_ptr): reads the summary's flags slot
  // (SBS_OFF_FLAGS = +40) and returns bit 1 (PDXB_FLAG_ENCRYPTED)
  // as a u64 0/1.
  pub let pdxb_sb_is_encrypted : (u64) -> u64 !{mem} @{} =
    fn (sb_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "libpdx-volume.M5-002 (#30): decode flags bit 1 (PDXB_FLAG_ENCRYPTED = 0x02). Load summary flags at +40, shift right by 1 then mask with 1 (both small imms, safe under paideia-as's imm-encoding rules). No conditional branch needed; the bit-value IS the boolean return.",
      block: {
        mov rax, [rdi + 40];
        shr rax, 1;
        and rax, 1;
        ret;
      }
    }
}
